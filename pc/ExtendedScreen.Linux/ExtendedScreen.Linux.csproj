<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AssemblyName>extendedscreen</AssemblyName>
    <RootNamespace>ExtendedScreen.Linux</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.95.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ExtendedScreen.Core\ExtendedScreen.Core.csproj" />
    <ProjectReference Include="..\ExtendedScreen.Server\ExtendedScreen.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="ExtendedScreen.Server" />
    <Using Include="ExtendedScreen.Server.Platform" />
  </ItemGroup>

</Project>
