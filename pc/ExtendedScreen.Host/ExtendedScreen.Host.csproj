<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AssemblyName>ExtendedScreen.Host</AssemblyName>
    <RootNamespace>ExtendedScreen.Host</RootNamespace>
    <!-- Lets the solution build on Linux too (the result still only runs on Windows). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <PackageReference Include="Vortice.MediaFoundation" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ExtendedScreen.Core\ExtendedScreen.Core.csproj" />
    <ProjectReference Include="..\ExtendedScreen.Server\ExtendedScreen.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="ExtendedScreen.Server" />
    <Using Include="ExtendedScreen.Server.Platform" />
  </ItemGroup>

</Project>
